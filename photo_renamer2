"""
Photo Renamer - Rename photos based on EXIF/creation date

Date Format: YYYY-MM-DD_HH;MM;SS
Example: 34895782357.png -> 2018-01-01_00;00;00.png

Fast Mode: Renames all files automatically
Slow Mode: Shows each file with rename dialog for manual control

@Author: Matthrose
@Version: 2.0

package guide:
    im richtigem ordner + mit pip install -r requirements.txt installieren
    pyinstaller PhotoRenamer.spec

Future Features:
(maybe: Add support for custom date format)
"""

from pathlib import Path
from datetime import datetime
from dataclasses import dataclass
from typing import Any
import re
import os

# GUI imports
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

# Image & process management
from PIL import Image
from PIL.ExifTags import TAGS

