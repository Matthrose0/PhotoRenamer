# ==================== DATA STRUCTURES ====================

@dataclass
class RenameOperation:
    """Stores information about a rename operation for undo functionality."""
    old_path: Path
    new_path: Path
    file_index: int


# ==================== DATE EXTRACTION ====================

def convert_date(dt: datetime) -> str:
    """Convert datetime to filename format: YYYY-MM-DD_HH;MM;SS"""
    return dt.strftime("%Y-%m-%d_%H;%M;%S")


def try_exif_date(file_path: Path) -> str | None:
    """Extract date from EXIF metadata (for photos only)."""
    try:
        with Image.open(file_path) as img:
            exif = img.getexif()
            if not exif:
                return None

            if (result := _check_direct_EXIF_tags(exif)):
                return result

            if (result := _check_nested_EXIF_tags(exif)):
                return result
    except Exception:
        pass
    return None


def _check_direct_EXIF_tags(exif: Any) -> str | None:
    for tag_id in exif.keys():
        tag_name = TAGS.get(tag_id, "")
        if tag_name not in ["DateTimeOriginal", "DateTime", "DateTimeDigitized"]:
            continue

        if (result := _check_EXIF_date(exif[tag_id])):
            return result
    return None


def _check_nested_EXIF_tags(exif: Any) -> str | None:
    # Method 2: Check nested EXIF IFD (where DateTimeOriginal usually is)
    # ExifOffset (34665) points to nested EXIF data
    if 34665 not in exif:
        return None

    exif_ifd = exif.get_ifd(34665)

    # Common date tags in EXIF IFD:
    # 36867 = DateTimeOriginal
    # 36868 = DateTimeDigitized
    # 306 = DateTime
    for date_tag in (36867, 36868, 306):
        if date_tag not in exif_ifd:
            continue

        if (result := _check_EXIF_date(exif_ifd[date_tag])):
            return result
    return None


def _check_EXIF_date(value: Any) -> str | None:
    try:
        if isinstance(value, bytes):
            value = value.decode('utf-8', errors='ignore')
        dt = datetime.strptime(str(value), "%Y:%m:%d %H:%M:%S")
        return convert_date(dt)
    except Exception:
        return None


def try_filename_date(file_path: Path) -> str | None:
    """Extract date from existing filename patterns."""
    patterns = [
        # YYYYMMDD or YYYY-MM-DD with optional time
        (r"(\d{4})[-_]?(\d{2})[-_]?(\d{2})[_-]?(\d{2})?(\d{2})?(\d{2})?",
         "%Y%m%d%H%M%S"),
        # DD-MM-YYYY or DD.MM.YYYY
        (r"(\d{2})[-_\.](\d{2})[-_\.](\d{4})", "%d%m%Y"),
    ]

    stem = file_path.stem
    for pattern, date_format in patterns:
        match = re.search(pattern, stem)
        if not match:
            continue

        digits = "".join(g for g in match.groups() if g)

        try:
            fmt = date_format[:len(digits)]
            dt = datetime.strptime(digits, fmt)
            return convert_date(dt)
        except Exception:
            continue

    return None


def try_creation_date(file_path: Path) -> str | None:
    """Use file creation date as fallback."""
    try:
        stat = file_path.stat()
        # st_birthtime exists on some platforms (e.g. macOS), otherwise fallback to st_ctime
        timestamp = getattr(stat, "st_birthtime", None) or stat.st_ctime
        dt = datetime.fromtimestamp(timestamp)
        return convert_date(dt)
    except Exception:
        return None


def get_new_filename(file_path: Path) -> str:
    """
    Get new filename for a file using multiple date sources.
    Priority: EXIF -> Creation Date -> Filename -> Original Name
    """
    result = try_exif_date(file_path)
    if result:
        return result

    result = try_creation_date(file_path)
    if result:
        return result

    result = try_filename_date(file_path)
    if result:
        return result

    return file_path.stem


# ==================== MAIN APPLICATION ====================

class PhotoRenamerApp:
    """Main application class for the Photo Renamer GUI."""

    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Photo Renamer")
        self.root.protocol("WM_DELETE_WINDOW", self.on_closing)

        # Application state
        self.theme = "light"
        self.directory: Path | None = None
        self.files: list[Path] = []
        self.current_index = 0
        self.rename_history: list[RenameOperation] = []
        self.is_processing = False

        self.setup_main_window()

    # ==================== WINDOW SETUP ====================

    def setup_main_window(self):
        """Initialize and configure the main application window."""
        width, height = 800, 600
        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        x = (screen_w - width) // 2
        y = (screen_h - height) // 2
        self.root.geometry(f"{width}x{height}+{x}+{y}")

        self.apply_theme()

        self._create_theme_selector()
        self._create_main_content()
        self._create_log_area()

    def _create_theme_selector(self):
        """Create theme selection dropdown."""
        frame = tk.Frame(self.root, bg=self.colors["bg"])
        frame.pack(side=tk.TOP, fill=tk.X, padx=10, pady=5)

        tk.Label(
            frame, text="Thema:",
            bg=self.colors["bg"], fg=self.colors["fg"]
        ).pack(side=tk.LEFT)

        self.theme_var = tk.StringVar(value=self.theme)
        dropdown = ttk.Combobox(
            frame, textvariable=self.theme_var,
            values=["dark", "light"], state="readonly", width=10
        )
        dropdown.pack(side=tk.LEFT, padx=5)
        dropdown.bind("<<ComboboxSelected>>", self.change_theme)

    def _create_main_content(self):
        """Create main content area with title and controls."""
        content = tk.Frame(self.root, bg=self.colors["bg"])
        content.pack(expand=True, fill=tk.BOTH, padx=20, pady=20)

        tk.Label(
            content, text="Photo Renamer",
            font=("Arial", 24, "bold"),
            bg=self.colors["bg"], fg=self.colors["fg"]
        ).pack(pady=(0, 30))

        self._create_directory_selector(content)
        self._create_mode_buttons(content)

    def _create_directory_selector(self, parent: tk.Frame):
        """Create directory selection controls."""
        frame = tk.Frame(parent, bg=self.colors["bg"])
        frame.pack(pady=10)

        self.dir_label = tk.Label(
            frame, text="Kein Verzeichnis ausgewählt",
            bg=self.colors["bg"], fg=self.colors["fg"],
            wraplength=500
        )
        self.dir_label.pack(side=tk.LEFT, padx=10)

        tk.Button(
            frame, text="📂 Verzeichnis auswählen",
            command=self.select_directory,
            bg=self.colors["button_bg"],
            fg=self.colors["button_fg"],
            activebackground=self.colors["button_active"],
            padx=15, pady=5
        ).pack(side=tk.LEFT)

    def _create_mode_buttons(self, parent: tk.Frame):
        """Create fast/slow mode selection buttons."""
        frame = tk.Frame(parent, bg=self.colors["bg"])
        frame.pack(pady=30)

        for text, command in [
            ("⚡ Schneller Modus", self.start_fast_mode),
            ("🎯 Langsamer Modus", self.start_slow_mode)
        ]:
            tk.Button(
                frame, text=text, command=command,
                bg=self.colors["button_bg"],
                fg=self.colors["button_fg"],
                activebackground=self.colors["button_active"],
                font=("Arial", 14), padx=30, pady=15, width=15
            ).pack(side=tk.LEFT, padx=10)

    def _create_log_area(self):
        """Create scrollable log text area."""
        content = self.root.winfo_children()[1]  # Get main content frame

        tk.Label(
            content, text="Umbenennungs Log:",
            bg=self.colors["bg"], fg=self.colors["fg"],
            font=("Arial", 10, "bold")
        ).pack(anchor=tk.W, pady=(20, 5))

        frame = tk.Frame(content, bg=self.colors["bg"])
        frame.pack(fill=tk.BOTH, expand=True)

        scrollbar = tk.Scrollbar(frame)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        self.log_text = tk.Text(
            frame, bg=self.colors["log_bg"],
            fg=self.colors["log_fg"], state=tk.DISABLED,
            yscrollcommand=scrollbar.set, wrap=tk.WORD, height=8
        )
        self.log_text.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.config(command=self.log_text.yview)

    # ==================== THEME MANAGEMENT ====================

    def apply_theme(self):
        """Apply color scheme from current theme."""
        self.colors = THEMES[self.theme]
        self.root.configure(bg=self.colors["bg"])

    def change_theme(self, event: tk.Event | None = None):
        """Switch between dark and light theme."""
        self.theme = self.theme_var.get()
        self.apply_theme()
        self._update_all_widgets(self.root)

    def _update_all_widgets(self, widget: tk.Widget):
        """Recursively update colors for all widgets."""
        try:
            if isinstance(widget, (tk.Frame, tk.Label, tk.Toplevel)):
                widget.configure(bg=self.colors["bg"])

            if isinstance(widget, tk.Label):
                widget.configure(fg=self.colors["fg"])

            if isinstance(widget, tk.Button):
                widget.configure(
                    bg=self.colors["button_bg"],
                    fg=self.colors["button_fg"],
                    activebackground=self.colors["button_active"]
                )

            if isinstance(widget, tk.Entry):
                widget.configure(
                    bg=self.colors["entry_bg"],
                    fg=self.colors["entry_fg"]
                )

            if isinstance(widget, tk.Text):
                widget.configure(
                    bg=self.colors["log_bg"],
                    fg=self.colors["log_fg"]
                )

            for child in widget.winfo_children():
                self._update_all_widgets(child)
        except Exception:
            # Silent fail to avoid UI break on theme update
            pass

    # ==================== UTILITY FUNCTIONS ====================
    def log(self, message: str):
        """Add timestamped message to log."""
        timestamp = datetime.now().strftime("%H:%M:%S")
        log_entry = f"[{timestamp}] {message}\n"

        self.log_text.config(state=tk.NORMAL)
        self.log_text.insert(tk.END, log_entry)
        self.log_text.see(tk.END)
        self.log_text.config(state=tk.DISABLED)

    def select_directory(self):
        """Open directory selection dialog and load files."""
        path = filedialog.askdirectory(
            title="Bitte Verzeichnis auswählen"
        )
        if not path:
            return

        self.directory = Path(path)
        self.dir_label.config(
            text=f"ausgewähltes Verzeichnis: {self.directory}"
        )

        self.files = [f for f in self.directory.iterdir() if f.is_file()]
        self.log(
            f"Es wurden {len(self.files)} Dateien im "
            f"ausgewählten Verzeichnis gefunden"
        )

    def on_closing(self):
        """Handle main window closing."""
        if self.is_processing:
            if not messagebox.askyesno(
                "Exit",
                "Ein Umbenennungsprozess läuft.\n\n"
                "Bist du sicher, dass du das Programm beenden möchtest?"
            ):
                return

            # Clean up
            self._close_media_viewer()
        try:
            self.root.quit()
            self.root.destroy()
        except Exception:
            pass

    def _safe_destroy_dialog(self, dialog: tk.Toplevel):
        """Safely destroy dialog window with error handling."""
        try:
            if dialog and dialog.winfo_exists():
                dialog.unbind_all("<Return>")
                dialog.protocol("WM_DELETE_WINDOW", lambda: None)
                dialog.withdraw()
                dialog.update_idletasks()
                dialog.destroy()
        except Exception:
            # suppressed to avoid cascading UI errors
            pass

    def _check_can_start(self) -> bool:
        """Validate that processing can start."""
        if not self.directory:
            messagebox.showwarning(
                "Kein Verzeichnis",
                "Bitte zuerst ein Verzeichnis auswählen!"
            )
            return False

        if not self.files:
            messagebox.showinfo(
                "Keine Dateien",
                "Es wurden keine Dateien im aktuellen "
                "Verzeichnis gefunden!"
            )
            return False

        if self.is_processing:
            messagebox.showwarning(
                "Ein Vorgang läuft bereits",
                "Bitte warten, bis der aktuelle Vorgang fertig ist!"
            )
            return False

        return True

    def _get_unique_path(self, base_path: Path, stem: str,
                         suffix: str) -> Path:
        """Generate unique filename by appending counter if needed."""
        new_path = base_path / (stem + suffix)
        counter = 1

        while new_path.exists():
            new_path = base_path / f"{stem}_{counter}{suffix}"
            counter += 1

        return new_path

    # ==================== FAST MODE ====================

    def start_fast_mode(self):
        """Automatically rename all files without user interaction."""
        if not self._check_can_start():
            return

        if not messagebox.askokcancel(
            "Schneller Modus",
            "Schneller Modus wird alle Dateien in dem gewählten "
            "Verzeichnis umbenennen.\n\nDrücke OK zum fortfahren."
        ):
            return

        self.is_processing = True
        self.log("Starte schnellen Modus...")
        success_count = 0

        for i, file_path in enumerate(self.files, 1):
            try:
                old_name = file_path.name
                new_stem = get_new_filename(file_path)
                new_path = self._get_unique_path(
                    file_path.parent, new_stem, file_path.suffix
                )

                file_path.rename(new_path)
                self.log(f"[{i}] {old_name} → {new_path.name}")
                success_count += 1

            except Exception as e:
                self.log(f"[{i}] ERROR: {file_path.name} - {str(e)}")

        self.is_processing = False
        self.log(
            f"Schneller Modus abgeschlossen! "
            f"{success_count}/{len(self.files)} umbenannt"
        )
        messagebox.showinfo(
            "Umbenennung abgeschlossen",
            f"Umbenannt: {success_count}/{len(self.files)} Dateien!"
        )

    # ==================== SLOW MODE ====================

    def start_slow_mode(self):
        """Interactively rename files one by one with preview."""
        if not self._check_can_start():
            return

        if not messagebox.askokcancel(
            "Langsamer Modus",
            "Langsamer Modus wird alle Dateien nacheinander umbenennen:\n\n"
            "• Bilder/Videos auf der linken Seite öffnen "
            "(2/3 vom Bildschirm)\n"
            "• Umbenennungsdialog auf der rechten Seite öffnen "
            "(1/3 vom Bildschirm)\n\n"
            "Du kannst die letzte Benennung rückgängig machen, "
            "die aktuelle überspringen, oder jede Benennung bestätigen.\n\n"
            "Drücke OK zum fortfahren."
        ):
            return

        self.is_processing = True
        self.log("Starte langsamen Modus...")
        self.current_index = 0
        self.rename_history = []

        # Minimize all windows for clean workspace (lazy import)
        try:
            import win32com.client as _w32sc
            _w32sc.Dispatch("Shell.Application").MinimizeAll()
        except Exception:
            pass

        self._process_next_file()

    def _process_next_file(self):
        """Process next file in slow mode queue."""
        if self.current_index >= len(self.files):
            self._finish_slow_mode()
            return

        file_path = self.files[self.current_index]

        # Ensure clean workspace
        try:
            import win32com.client as _w32sc
            _w32sc.Dispatch("Shell.Application").MinimizeAll()
        except Exception:
            pass

        try:
            os.startfile(str(file_path))
            self.root.after(600, self._position_media_window)
        except Exception as e:
            self.log(f"Fehler beim Öffnen: {str(e)}")

        if self.root and self.root.winfo_exists():
            self.root.after(900, lambda: self._show_rename_dialog(file_path))

    def _position_media_window(self):
        """Move media viewer to left 2/3 of screen."""
        try:
            import win32gui  # lazy import
            screen_w = self.root.winfo_screenwidth()
            screen_h = self.root.winfo_screenheight()

            width = int(screen_w * 2 / 3)
            height = screen_h - 30  # Leave space for taskbar

            hwnd = win32gui.GetForegroundWindow()
            if hwnd:
                win32gui.MoveWindow(hwnd, 0, 0, width, height, True)
        except Exception as e:
            self.log(f"Fehler beim Positionieren: {str(e)}")

    def _show_rename_dialog(self, file_path: Path):
        """Display rename dialog for current file."""
        if not (self.root and self.root.winfo_exists()):
            return

        dialog = tk.Toplevel(self.root)

        dialog.title("Datei umbenennen")
        dialog.configure(bg=self.colors["bg"])

        screen_h = dialog.winfo_screenheight()
        screen_w = dialog.winfo_screenwidth()
        width = int(screen_w / 3)
        height = int(screen_h / 2)
        x = int(screen_w / 1.5)
        dialog.geometry(f"{width}x{height}+{x}+0")

        content = tk.Frame(dialog, bg=self.colors["bg"])
        content.pack(expand=True, fill=tk.BOTH, padx=20, pady=20)

        self._add_dialog_counter(content)
        self._add_dialog_old_name(content, file_path)
        new_entry = self._add_dialog_new_name(content, file_path)
        self._add_dialog_buttons(content, dialog, file_path, new_entry)

        new_entry.bind(
            "<Return>",
            lambda e: self._confirm_rename(
                dialog, file_path, new_entry.get()
            )
        )
        dialog.protocol(
            "WM_DELETE_WINDOW",
            lambda: self._skip_file(dialog)
        )

        dialog.lift()
        dialog.focus_force()
        dialog.attributes('-topmost', True)
        dialog.after(100, lambda: dialog.attributes('-topmost', False))
        new_entry.focus_force()
        new_entry.icursor(tk.END)

    def _add_dialog_counter(self, parent: tk.Frame):
        """Add file counter label to dialog."""
        counter_text = (
            f"Datei {self.current_index + 1} von {len(self.files)}"
        )
        tk.Label(
            parent, text=counter_text,
            bg=self.colors["bg"], fg=self.colors["fg"],
            font=("Arial", 10)
        ).pack(pady=(0, 20))

    def _add_dialog_old_name(self, parent: tk.Frame, file_path: Path) -> tk.Entry:
        """Add readonly field showing current filename."""
        tk.Label(
            parent, text="Aktueller Name:",
            bg=self.colors["bg"], fg=self.colors["fg"],
            font=("Arial", 10, "bold")
        ).pack(anchor=tk.W)

        entry = tk.Entry(
            parent, bg=self.colors["entry_bg"],
            fg=self.colors["entry_fg"],
            state="readonly", font=("Arial", 10)
        )
        entry.pack(fill=tk.X, pady=(5, 20))

        entry.config(state=tk.NORMAL)
        entry.insert(0, file_path.name)
        entry.config(state="readonly")

        return entry

    def _add_dialog_new_name(self, parent: tk.Frame, file_path: Path) -> tk.Entry:
        """Add editable field for new filename with suggestion."""
        tk.Label(
            parent, text="Neuer Name:",
            bg=self.colors["bg"], fg=self.colors["fg"],
            font=("Arial", 10, "bold")
        ).pack(anchor=tk.W)

        entry = tk.Entry(
            parent, bg=self.colors["entry_bg"],
            fg=self.colors["entry_fg"], font=("Arial", 10)
        )
        entry.pack(fill=tk.X, pady=(5, 30))

        suggested = get_new_filename(file_path) + file_path.suffix
        entry.insert(0, suggested)
        entry.select_range(0, tk.END)

        return entry

    def _add_dialog_buttons(self, parent: tk.Frame, dialog: tk.Toplevel,
                            file_path: Path, new_entry: tk.Entry):
        """Add action buttons to dialog."""
        frame = tk.Frame(parent, bg=self.colors["bg"])
        frame.pack(side=tk.BOTTOM, pady=10)

        buttons = [
            ("↶ rückgängig machen",
             lambda: self._undo_last(dialog),
             bool(self.rename_history)),
            ("Überspringen",
             lambda: self._skip_file(dialog),
             True),
            ("✓ bestätigen",
             lambda: self._confirm_rename(dialog, file_path, new_entry.get()),
             True),
            ("⬛ Prozess beenden",
             lambda: self._stop_slow_mode(dialog),
             True),
        ]

        for text, command, show in buttons:
            if not show:
                continue

            tk.Button(
                frame, text=text, command=command,
                bg=self.colors["button_bg"],
                fg=self.colors["button_fg"],
                activebackground=self.colors["button_active"],
                padx=10, pady=5
            ).pack(side=tk.LEFT, padx=5)

    def _confirm_rename(self, dialog: tk.Toplevel,
                        file_path: Path, new_name: str):
        """Execute rename operation and continue to next file."""
        try:
            self._close_media_viewer()

            new_path = self._get_unique_path(
                file_path.parent,
                Path(new_name).stem,
                Path(new_name).suffix
            )

            old_name = file_path.name
            file_path.rename(new_path)

            self.files[self.current_index] = new_path
            self.rename_history.append(
                RenameOperation(
                    old_path=file_path.parent / old_name,
                    new_path=new_path,
                    file_index=self.current_index
                )
            )

            self.current_index += 1
            self.log(f"[{self.current_index}] {old_name} → {new_path.name}")

            self._safe_destroy_dialog(dialog)
            self.root.after(10, self._process_next_file)

        except Exception as e:
            self.log(f"ERROR: {str(e)}")
            if messagebox.askyesno(
                "Fehler beim Umbenennen",
                f"Fehler beim Umbenennen der Datei:\n{str(e)}\n\n"
                "Diese Datei überspringen?"
            ):
                self._skip_file(dialog)

    def _skip_file(self, dialog: tk.Toplevel):
        """Skip current file and move to next."""
        self._close_media_viewer()

        file_path = self.files[self.current_index]
        self.log(
            f"[{self.current_index + 1}] "
            f"Übersprungen: {file_path.name}"
        )

        self._safe_destroy_dialog(dialog)
        self.current_index += 1
        self.root.after(10, self._process_next_file)

    def _undo_last(self, dialog: tk.Toplevel):
        """Revert last rename operation."""
        if not self.rename_history:
            return

        self._close_media_viewer()
        last_op = self.rename_history.pop()

        try:
            last_op.new_path.rename(last_op.old_path)
            self.files[last_op.file_index] = last_op.old_path

            self.log(
                f"UNDO: {last_op.new_path.name} → "
                f"{last_op.old_path.name}"
            )

            self._safe_destroy_dialog(dialog)
